{
  "name": "@particle-academy/fancy-inertia",
  "version": "0.9.7",
  "description": "Inertia.js integration for the fancy UI set — app-shell providers, SSR helpers, useFancyForm() bridge, schema-driven page rendering.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Particle-Academy/fancy-inertia.git"
  },
  "homepage": "https://github.com/Particle-Academy/fancy-inertia#readme",
  "bugs": "https://github.com/Particle-Academy/fancy-inertia/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./seo": {
      "import": {
        "types": "./dist/seo/index.d.ts",
        "default": "./dist/seo/index.js"
      },
      "require": {
        "types": "./dist/seo/index.d.cts",
        "default": "./dist/seo/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server/index.js"
      },
      "require": {
        "types": "./dist/server/index.d.cts",
        "default": "./dist/server/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./pwa": {
      "import": {
        "types": "./dist/pwa/index.d.ts",
        "default": "./dist/pwa/index.js"
      },
      "require": {
        "types": "./dist/pwa/index.d.cts",
        "default": "./dist/pwa/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit && eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "prepublishOnly": "tsup"
  },
  "keywords": [
    "react",
    "inertia",
    "inertiajs",
    "laravel",
    "ssr",
    "particle-academy"
  ],
  "dependencies": {
    "@particle-academy/fancy-app-update": ">=0.1 <2.0"
  },
  "peerDependencies": {
    "@inertiajs/react": "^1.0.0 || ^2.0.0 || ^3.0.0",
    "@particle-academy/fancy-echarts": "^3.0.0 || ^4.0.0 || ^5.0.0",
    "@particle-academy/fancy-pwa": ">=0.1",
    "@particle-academy/fancy-screens": ">=0.4 <2.0",
    "@particle-academy/react-fancy": ">=3",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "form-data": "^4.0.6"
  },
  "peerDependenciesMeta": {
    "@particle-academy/fancy-echarts": {
      "optional": true
    },
    "@particle-academy/fancy-screens": {
      "optional": true
    },
    "@particle-academy/fancy-pwa": {
      "optional": true
    }
  },
  "devDependencies": {
    "@inertiajs/react": "^3.6.1",
    "@particle-academy/fancy-echarts": "^5.0.0",
    "@particle-academy/fancy-pwa": "^0.1.5",
    "@particle-academy/fancy-screens": "^0.6.0",
    "@particle-academy/react-fancy": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
